# ── Application ───────────────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=file:/app/data/omnivote.db
PORT=3000
HOSTNAME=0.0.0.0

# ── Auth (generate strong random values for production!) ─────────────
# Example: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_64_CHAR_RANDOM_STRING

# ── Encryption (32+ characters) ───────────────────────────────────────
# Example: openssl rand -base64 32
OMNIVOTE_ENCRYPTION_KEY=REPLACE_WITH_A_32_CHAR_KEY

# ── Docker Compose Ports ─────────────────────────────────────────────
APP_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443