# ─── OmniVote .dockerignore ──────────────────────────────────────

# Dependencies
node_modules

# Build output
.next

# Version control
.git
.gitignore

# Documentation
*.md
LICENSE*

# Docker files (avoid recursive builds)
Dockerfile
docker-compose*.yml
.dockerignore
Makefile

# Environment files (injected at runtime)
.env
.env.*
!.env.example

# Test files & coverage
coverage
src/**/*.test.ts
src/**/*.test.tsx
src/**/*.stories.tsx
src/**/__tests__
src/stories
src/__mocks

# Storybook
.storybook

# Development & tooling
skills
download
agent-ctx
examples
whatsapp-bridge
load-tests
*.bak

# Monitoring (not needed in app image)
monitoring

# CI/CD
.github

# IDE
.vscode
.idea

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Misc
Caddyfile
start-bridge.sh
tool-results