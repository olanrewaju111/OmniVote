{
  "annotations": {
    "list": [
      {"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}
    ]
  },
  "description": "OmniVote System Overview — SRE Monitoring Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "API Availability",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "omnivote_slo_current_sli{slo=\"api_availability\"}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.999}, {"color": "green", "value": 0.9995}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "id": 1
    },
    {
      "title": "Request Rate (req/min)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(rate(omnivote_http_requests_total[1m])) * 60", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "sum(rate(omnivote_http_errors_total[5m])) / sum(rate(omnivote_http_requests_total[5m]))", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.05}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "title": "p95 Latency (s)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(omnivote_http_request_duration_seconds_bucket[5m])) by (le))", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 2}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "title": "Request Rate Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "sum(rate(omnivote_http_requests_total[1m])) * 60", "legendFormat": "Total req/min", "refId": "A"},
        {"expr": "sum(rate(omnivote_http_errors_total[1m])) * 60", "legendFormat": "5xx errors/min", "refId": "B"}
      ],
      "id": 5
    },
    {
      "title": "Memory Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "omnivote_process_memory_rss_bytes", "legendFormat": "RSS", "refId": "A", "unit": "bytes"},
        {"expr": "omnivote_process_memory_heap_used_bytes", "legendFormat": "Heap Used", "refId": "B", "unit": "bytes"},
        {"expr": "omnivote_process_memory_heap_total_bytes", "legendFormat": "Heap Total", "refId": "C", "unit": "bytes"}
      ],
      "id": 6
    },
    {
      "title": "SLO Error Budgets",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "targets": [{"expr": "omnivote_slo_error_budget_remaining", "legendFormat": "{{slo}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 25}, {"color": "green", "value": 50}]},
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "options": {"orientation": "horizontal", "displayMode": "gradient", "minVizWidth": 0, "minVizHeight": 10},
      "id": 7
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["omnivote", "sre"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "title": "OmniVote System Overview",
  "uid": "omnivote-overview"
}